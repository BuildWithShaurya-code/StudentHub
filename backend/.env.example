# StudentHub Backend Database & Server Configuration
# Copy this file to .env and replace placeholders with your actual local configuration.
# Never commit your actual .env file to Git!

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studenthub_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Flask Server Configuration
FLASK_PORT=5001
FLASK_DEBUG=False

# CORS Configuration (Origin where the Vite/React frontend runs)
FRONTEND_ORIGIN=http://localhost:3000
